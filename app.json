{
  "expo": {
    "name": "MarZlog",
    "slug": "marzlog-app",
    "owner": "marzlogs-organization",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "marzlog",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "locales": {
      "en": "./locales/en.json",
      "ko": "./locales/ko.json"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.marzlog.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.marzlog.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["DEFAULT", "BROWSABLE"],
          "data": [
            { "scheme": "com.googleusercontent.apps.446583916256-ichiq3gh2mvsm01kftom6iji65i4ut1k" }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "MarZlog uses Face ID to lock the app and keep your photos and diary entries private. For example, unlock the app with Face ID instead of entering your passcode."
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "MarZlog needs access to your photo library so you can select photos to create diary entries. For example, choose today's photos to generate an AI diary.",
          "cameraPermission": "MarZlog uses the camera so you can take photos and attach them to your diary. For example, capture this moment and add it directly to today's entry.",
          "microphonePermission": false
        }
      ],
      ["expo-alternate-app-icons", {
        "icons": {
          "coral": "./assets/images/app-icons/coral.png",
          "red": "./assets/images/app-icons/red.png"
        }
      }],
      ["expo-notifications", {
        "icon": "./assets/images/notification-icon.png",
        "color": "#8B5CF6",
        "androidMode": "default",
        "androidCollapsedTitle": "MarZlog 알림"
      }],
      ["@react-native-kakao/core", {
        "nativeAppKey": "2ef2adfdcd23585a092e8bebba21d60c",
        "android": {
          "authCodeHandlerActivity": true
        },
        "ios": {
          "handleKakaoOpenUrl": true
        }
      }],
      ["expo-build-properties", {
        "android": {
          "extraMavenRepos": ["https://devrepo.kakao.com/nexus/content/groups/public/"],
          "extraProguardRules": "-keep class com.kakao.** { *; }",
          "packagingOptions": {
            "pickFirst": ["**/libc++_shared.so"]
          }
        },
        "ios": {
          "deploymentTarget": "15.5",
          "extraPods": [
            { "name": "GoogleSignIn", "version": "9.1.0" },
            { "name": "AppCheckCore", "version": "11.2.0" }
          ]
        }
      }],
      ["@sentry/react-native/expo", {
        "organization": "jjsim-inc",
        "project": "react-native"
      }],
      "expo-apple-authentication",
      "expo-video",
      "./plugins/withGradleMemory",
      "./plugins/withPrivacyManifest",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "MarZlog saves photos to your library when you download images from your diary. For example, save a diary photo back to your camera roll.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MarZlog uses your location to tag where photos were taken in your diary. For example, your entry can show the place where you captured the moment.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false
        }
      ]
    ],
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/992b64cc-e784-4984-8e08-fdc26f45088b"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "992b64cc-e784-4984-8e08-fdc26f45088b"
      }
    }
  }
}
